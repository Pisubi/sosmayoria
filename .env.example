# Copiar a .env.local (no se versiona) o cargar en el hosting.
# Sin estas variables el juego funciona igual, sin pedir datos ni guardar partidas.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx

# Dirección pública del juego, para la imagen de historias (si falta, se usa la de la página).
VITE_URL_PUBLICA=https://lamayoria.com.ar
